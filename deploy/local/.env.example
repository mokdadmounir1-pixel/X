# Copier en .env puis remplacer chaque valeur par un mot de passe long et unique (ex. : openssl rand -base64 24).
# .env est ignoré par git. Ne jamais le coller dans un chat, un ticket ou un log.
NEXUS_PG_PORT=5433
NEXUS_PG_ADMIN_PASSWORD=CHANGER
NEXUS_OWNER_PASSWORD=CHANGER
NEXUS_WORKER_PASSWORD=CHANGER
NEXUS_CENSOR_PASSWORD=CHANGER
NEXUS_FOUNDER_PASSWORD=CHANGER
NEXUS_TRANSPORT_PASSWORD=CHANGER
